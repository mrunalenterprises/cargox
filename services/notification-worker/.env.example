SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
LOADIN_NOTIFICATION_BATCH=100
FCM_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Preferred: service account as JSON (raw or base64)
FCM_SERVICE_ACCOUNT_JSON=SERVER_ONLY_FIREBASE_SERVICE_ACCOUNT_JSON
# Alternative to FCM_SERVICE_ACCOUNT_JSON:
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@YOUR_PROJECT.iam.gserviceaccount.com
# FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Debug/deployment override only; short-lived OAuth token:
# FCM_ACCESS_TOKEN=
