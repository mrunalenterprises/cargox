# LOADIN secure Admin/Fleet portal API
PORT=8790
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public anon key only. User JWT is forwarded to Supabase RPCs; do not put service-role here.
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Comma-separated production web origins. No wildcard.
LOADIN_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Recommended true in production so non-browser/no-Origin access is rejected except /health and /ready.
LOADIN_REQUIRE_BROWSER_ORIGINS=true
# 1 KB minimum, 1 MB hard maximum.
LOADIN_PORTAL_MAX_BODY_BYTES=32768
